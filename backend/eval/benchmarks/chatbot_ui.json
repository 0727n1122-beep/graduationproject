{
  "id": "chatbot_ui",
  "name": "챗봇 UI",
  "original_prompt": "챗봇처럼 메시지 주고받는 화면 하나 만들어주세요 왼쪽엔 상대방 말풍선 오른쪽엔 내 말풍선 이렇게 대화하는 것처럼 보이면 좋겠고 밑에 뭐 입력할 수 있는 칸이랑 보내는 버튼도 있어야 돼요",
  "checklist": [
    {
      "id": "c1_send",
      "description": "[명시] 입력하고 보내기 버튼을 누르면 내 메시지가 대화창에 나타난다",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type]), textarea",
          "value": "오늘 날씨 어때?"
        },
        {
          "type": "click",
          "selectors": [
            "button:has-text('전송')",
            "button:has-text('보내기')",
            "button:has-text('Send')",
            "button[type='submit']",
            "[class*=send]",
            "button"
          ]
        }
      ],
      "type": "text_contains_any",
      "texts": [
        "오늘 날씨 어때?"
      ]
    },
    {
      "id": "c2_my_bubble_right",
      "description": "[명시] 내 말풍선이 오른쪽에 붙는다",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type]), textarea",
          "value": "오늘 날씨 어때?"
        },
        {
          "type": "click",
          "selectors": [
            "button:has-text('전송')",
            "button:has-text('보내기')",
            "button:has-text('Send')",
            "button[type='submit']",
            "[class*=send]",
            "button"
          ]
        },
        {
          "type": "expect_text",
          "text": "오늘 날씨 어때?"
        }
      ],
      "type": "js",
      "expr": "const els = [...document.querySelectorAll('body *')].filter(e => [...e.childNodes].some(n => n.nodeType === 3 && n.textContent.includes('오늘 날씨 어때?'))); if (!els.length) return false; const r = els[els.length - 1].getBoundingClientRect(); return (r.left + r.right) / 2 > window.innerWidth / 2;"
    },
    {
      "id": "c3_bot_reply",
      "description": "[명시] 메시지를 보내면 상대방(챗봇)이 답장한다 (주고받기)",
      "actions": [
        {
          "type": "js",
          "code": "window.__len = document.body.innerText.length; window.__bot = document.querySelectorAll('[class*=bot], [class*=assistant], [class*=received], [class*=other], [class*=left]').length;"
        },
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type]), textarea",
          "value": "오늘 날씨 어때?"
        },
        {
          "type": "click",
          "selectors": [
            "button:has-text('전송')",
            "button:has-text('보내기')",
            "button:has-text('Send')",
            "button[type='submit']",
            "[class*=send]",
            "button"
          ]
        },
        {
          "type": "wait",
          "ms": 3000
        }
      ],
      "type": "any_of",
      "checks": [
        {
          "type": "js",
          "expr": "return document.querySelectorAll('[class*=bot], [class*=assistant], [class*=received], [class*=other], [class*=left]').length > window.__bot;"
        },
        {
          "type": "js",
          "expr": "return document.body.innerText.length - window.__len > '오늘 날씨 어때?'.length + 12;"
        }
      ]
    },
    {
      "id": "c4_enter",
      "description": "[암묵] Enter 키로도 보내진다",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type]), textarea",
          "value": "오늘 날씨 어때?"
        },
        {
          "type": "press",
          "selector": "input[type='text'], input:not([type]), textarea",
          "key": "Enter"
        }
      ],
      "type": "text_contains_any",
      "texts": [
        "오늘 날씨 어때?"
      ]
    },
    {
      "id": "c5_input_cleared",
      "description": "[암묵] 보내고 나면 입력칸이 비워진다",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type]), textarea",
          "value": "오늘 날씨 어때?"
        },
        {
          "type": "click",
          "selectors": [
            "button:has-text('전송')",
            "button:has-text('보내기')",
            "button:has-text('Send')",
            "button[type='submit']",
            "[class*=send]",
            "button"
          ]
        }
      ],
      "type": "js",
      "expr": "return [...document.querySelectorAll(\"input[type='text'], input:not([type]), textarea\")].every(e => e.value.trim() === '');"
    },
    {
      "id": "c6_mobile_fit",
      "description": "[암묵] 휴대폰 폭(375px)에서 가로로 넘치지 않는다 (좌우 스크롤 없음)",
      "actions": [
        {
          "type": "set_viewport",
          "width": 375,
          "height": 812
        }
      ],
      "type": "js",
      "expr": "return document.documentElement.scrollWidth <= window.innerWidth + 1;"
    }
  ]
}
