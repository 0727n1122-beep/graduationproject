{
  "id": "todo_app",
  "name": "할 일 목록 앱",
  "original_prompt": "할 일 적어두는 거 하나 만들어줘 적고 체크하면 줄 긋히는 것처럼 되면 좋겠고 지우기도 되면 좋겠어",
  "checklist": [
    {
      "id": "c1_add",
      "description": "[명시] 할 일을 적고 추가 버튼을 누르면 목록에 나타난다",
      "complaint": "할 일을 적고 추가를 눌러도 목록에 안 생겨요",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type])",
          "value": "우유 사기"
        },
        {
          "type": "click",
          "selectors": [
            "button:has-text('추가')",
            "button:has-text('등록')",
            "button:has-text('Add')",
            "button:has-text('+')",
            "button[type='submit']",
            "button"
          ]
        }
      ],
      "type": "text_contains_any",
      "texts": [
        "우유 사기"
      ]
    },
    {
      "id": "c2_strike",
      "description": "[명시] 체크하면 실제로 취소선이 그어진다",
      "complaint": "체크해도 줄이 안 그어져요",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type])",
          "value": "우유 사기"
        },
        {
          "type": "click",
          "selectors": [
            "button:has-text('추가')",
            "button:has-text('등록')",
            "button:has-text('Add')",
            "button:has-text('+')",
            "button[type='submit']",
            "button"
          ]
        },
        {
          "type": "expect_text",
          "text": "우유 사기"
        },
        {
          "type": "click",
          "selector": "input[type='checkbox']"
        }
      ],
      "type": "computed_style_any",
      "selector": "body *",
      "property": "text-decoration-line",
      "value": "line-through"
    },
    {
      "id": "c3_delete",
      "description": "[명시] 삭제 버튼을 누르면 그 항목이 사라진다",
      "complaint": "삭제를 눌러도 안 지워져요",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type])",
          "value": "우유 사기"
        },
        {
          "type": "click",
          "selectors": [
            "button:has-text('추가')",
            "button:has-text('등록')",
            "button:has-text('Add')",
            "button:has-text('+')",
            "button[type='submit']",
            "button"
          ]
        },
        {
          "type": "expect_text",
          "text": "우유 사기"
        },
        {
          "type": "click",
          "selectors": [
            "button:has-text('삭제')",
            "button:has-text('지우기')",
            "button:has-text('Delete')",
            "button:has-text('×')",
            "button:has-text('✕')",
            "button:has-text('🗑')",
            "[class*=delete]",
            "[class*=remove]"
          ]
        },
        {
          "type": "wait",
          "ms": 1000
        }
      ],
      "type": "not",
      "check": {
        "type": "text_contains_any",
        "texts": [
          "우유 사기"
        ]
      }
    },
    {
      "id": "c4_enter",
      "description": "[암묵] 버튼 대신 Enter 키로도 추가된다",
      "complaint": "엔터를 쳐도 추가가 안 돼서 매번 버튼을 눌러야 해요",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type])",
          "value": "우유 사기"
        },
        {
          "type": "press",
          "selector": "input[type='text'], input:not([type])",
          "key": "Enter"
        }
      ],
      "type": "text_contains_any",
      "texts": [
        "우유 사기"
      ]
    },
    {
      "id": "c5_blank_rejected",
      "description": "[암묵] 빈 칸(공백만)으로 추가하면 빈 항목이 생기지 않는다",
      "complaint": "아무것도 안 쓰고 추가를 누르면 빈 할 일이 생겨요",
      "actions": [
        {
          "type": "js",
          "code": "window.__n = document.querySelectorAll('li, input[type=checkbox], [class*=todo-item], [class*=task-item]').length;"
        },
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type])",
          "value": "   "
        },
        {
          "type": "click",
          "selectors": [
            "button:has-text('추가')",
            "button:has-text('등록')",
            "button:has-text('Add')",
            "button:has-text('+')",
            "button[type='submit']",
            "button"
          ]
        }
      ],
      "type": "js",
      "expr": "return document.querySelectorAll('li, input[type=checkbox], [class*=todo-item], [class*=task-item]').length === window.__n;"
    },
    {
      "id": "c6_persist",
      "description": "[암묵] 새로고침해도 할 일이 남아 있다",
      "complaint": "새로고침하니까 적어둔 게 다 사라졌어요",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='text'], input:not([type])",
          "value": "우유 사기"
        },
        {
          "type": "click",
          "selectors": [
            "button:has-text('추가')",
            "button:has-text('등록')",
            "button:has-text('Add')",
            "button:has-text('+')",
            "button[type='submit']",
            "button"
          ]
        },
        {
          "type": "expect_text",
          "text": "우유 사기"
        },
        {
          "type": "reload"
        }
      ],
      "type": "text_contains_any",
      "texts": [
        "우유 사기"
      ]
    },
    {
      "id": "c7_mobile_fit",
      "description": "[암묵] 휴대폰 폭(375px)에서 가로로 넘치지 않는다 (좌우 스크롤 없음)",
      "complaint": "폰으로 보면 화면이 옆으로 삐져나가서 좌우로 밀려요",
      "actions": [
        {
          "type": "set_viewport",
          "width": 375,
          "height": 812
        }
      ],
      "type": "js",
      "expr": "return document.documentElement.scrollWidth <= window.innerWidth + 1;"
    }
  ]
}
