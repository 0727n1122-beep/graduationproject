{
  "id": "login_form",
  "name": "로그인 폼",
  "original_prompt": "로그인 화면 만들어줘 아이디 비번 입력하고 로그인 버튼 있으면 되고 회원가입 링크도 하나 있으면 좋겠어",
  "checklist": [
    {
      "id": "c1_id_input",
      "description": "[명시] 아이디/이메일 입력칸이 있다",
      "complaint": "아이디 입력칸이 없어요",
      "type": "element_exists",
      "selector": "input[type='email'], input[type='text'], input:not([type])"
    },
    {
      "id": "c2_password",
      "description": "[명시] 비밀번호 입력칸이 가려진다(●●●)",
      "complaint": "비밀번호 입력칸이 없거나 글자가 그대로 보여요",
      "type": "element_exists",
      "selector": "input[type='password']"
    },
    {
      "id": "c3_login_button",
      "description": "[명시] 로그인 버튼이 있다",
      "complaint": "로그인 버튼이 없어요",
      "type": "any_of",
      "checks": [
        {
          "type": "element_exists",
          "selector": "button[type='submit'], input[type='submit']"
        },
        {
          "type": "text_contains_any",
          "texts": [
            "로그인",
            "Login",
            "Sign in"
          ]
        }
      ]
    },
    {
      "id": "c4_signup_link",
      "description": "[명시] 회원가입 링크가 눌리는 요소(a/button)다",
      "complaint": "회원가입 링크가 없거나 눌러지지 않아요",
      "type": "element_exists",
      "selector": "a:has-text('회원가입'), button:has-text('회원가입'), a:has-text('가입'), a:has-text('Sign up'), button:has-text('Sign up')"
    },
    {
      "id": "c5_blank_feedback",
      "description": "[암묵] 빈 칸으로 로그인을 누르면 막히거나 안내가 나온다",
      "complaint": "아무것도 안 넣고 로그인을 눌러도 아무 반응이 없어요",
      "actions": [
        {
          "type": "js",
          "code": "window.__t = document.body.innerText; window.__u = location.href;"
        },
        {
          "type": "click",
          "selectors": [
            "button[type='submit']",
            "input[type='submit']",
            "button:has-text('로그인')",
            "button:has-text('Login')",
            "button:has-text('Sign in')"
          ]
        }
      ],
      "type": "js",
      "expr": "const f = document.querySelector('form'); if (f && !f.checkValidity()) return true; return window.__t !== undefined && (window.__dialogs.length > 0 || document.body.innerText !== window.__t);"
    },
    {
      "id": "c6_login_feedback",
      "description": "[암묵] 입력하고 로그인을 누르면 성공/실패 등 반응이 있다 (그냥 새로고침되지 않음)",
      "complaint": "아이디랑 비번을 넣고 로그인을 눌러도 아무 반응이 없어요",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='email'], input[type='text'], input:not([type])",
          "value": "test@example.com"
        },
        {
          "type": "fill",
          "selector": "input[type='password']",
          "value": "password123"
        },
        {
          "type": "js",
          "code": "window.__t = document.body.innerText; window.__u = location.href;"
        },
        {
          "type": "click",
          "selectors": [
            "button[type='submit']",
            "input[type='submit']",
            "button:has-text('로그인')",
            "button:has-text('Login')",
            "button:has-text('Sign in')"
          ]
        },
        {
          "type": "wait",
          "ms": 500
        }
      ],
      "type": "js",
      "expr": "return window.__t !== undefined && (window.__dialogs.length > 0 || document.body.innerText !== window.__t);"
    },
    {
      "id": "c7_enter_submits",
      "description": "[암묵] 비밀번호 칸에서 Enter를 눌러도 로그인된다",
      "complaint": "비밀번호 치고 엔터를 눌러도 로그인이 안 돼요",
      "actions": [
        {
          "type": "fill",
          "selector": "input[type='email'], input[type='text'], input:not([type])",
          "value": "test@example.com"
        },
        {
          "type": "fill",
          "selector": "input[type='password']",
          "value": "password123"
        },
        {
          "type": "js",
          "code": "window.__t = document.body.innerText; window.__u = location.href;"
        },
        {
          "type": "press",
          "selector": "input[type='password']",
          "key": "Enter"
        },
        {
          "type": "wait",
          "ms": 500
        }
      ],
      "type": "js",
      "expr": "return window.__t !== undefined && (window.__dialogs.length > 0 || document.body.innerText !== window.__t);"
    },
    {
      "id": "c8_mobile_fit",
      "description": "[암묵] 휴대폰 폭(375px)에서 가로로 넘치지 않는다 (좌우 스크롤 없음)",
      "complaint": "폰으로 보면 화면이 옆으로 삐져나가서 좌우로 밀려요",
      "actions": [
        {
          "type": "set_viewport",
          "width": 375,
          "height": 812
        }
      ],
      "type": "js",
      "expr": "return document.documentElement.scrollWidth <= window.innerWidth + 1;"
    }
  ]
}
