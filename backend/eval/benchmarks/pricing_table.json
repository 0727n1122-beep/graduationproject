{
  "id": "pricing_table",
  "name": "요금제 비교 테이블",
  "original_prompt": "우리 서비스 요금제 비교하는 표 같은거 만들어줘 무료 유료 이렇게 나뉘고 가격이랑 뭐 되는지 안되는지 표시되면 좋겠어",
  "checklist": [
    {
      "id": "c1_multiple_plans",
      "description": "요금제가 최소 2개 구분돼 보인다 (카드형 구조든 표 구조든 무관)",
      "type": "any_of",
      "checks": [
        { "type": "element_count_min", "selector": "[class*=plan], [class*=card], [class*=tier]", "min": 2 },
        { "type": "element_count_min", "selector": "table th", "min": 2 }
      ]
    },
    {
      "id": "c2_price",
      "description": "가격(원/₩/달러 또는 무료) 표시가 있다",
      "type": "text_regex",
      "pattern": "\\d{1,3}(,\\d{3})*\\s*원|₩\\s*\\d|\\$\\s*\\d|무료"
    },
    {
      "id": "c3_feature_list",
      "description": "제공 기능 목록이 최소 3개 있다",
      "type": "any_of",
      "checks": [
        { "type": "element_count_min", "selector": "li", "min": 3 },
        { "type": "element_count_min", "selector": "[class*=feature]", "min": 3 }
      ]
    },
    {
      "id": "c4_check_mark",
      "description": "가능/불가능을 나타내는 표시가 있다",
      "type": "text_contains_any",
      "texts": ["✓", "✔", "✗", "가능", "불가능", "O", "X"]
    },
    {
      "id": "c5_cta_button",
      "description": "가입/선택 버튼이 있다",
      "type": "any_of",
      "checks": [
        { "type": "element_exists", "selector": "button" },
        { "type": "text_contains_any", "texts": ["선택", "가입", "구독", "Choose", "Subscribe"] }
      ]
    },
    {
      "id": "c6_viewport",
      "description": "모바일 대응을 위한 viewport meta 태그가 있다",
      "type": "element_exists",
      "selector": "meta[name='viewport']"
    }
  ]
}
