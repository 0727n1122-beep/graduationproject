# 로컬 개발용 환경변수 예시 — 복사해서 .env.local로 만든 뒤 실제 값을 채워주세요
# cp .env.example .env.local

# Google OAuth 클라이언트 ID (Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# 백엔드 API 주소 (로컬 개발 시 기본값, 배포 후에는 실제 배포 URL로 변경)
NEXT_PUBLIC_API_URL=http://localhost:8000
